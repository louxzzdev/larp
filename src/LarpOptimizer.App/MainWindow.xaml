<Window x:Class="LarpOptimizer.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LARP Optimizer"
 Width="1100" Height="765" MinWidth="525" MinHeight="450"
 Background="{DynamicResource Canvas}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="13"
 WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="Sidebar" Width="184"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource Rail}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,1,0">
   <DockPanel Margin="9,10">
    <Button x:Name="SidebarToggle" DockPanel.Dock="Top" Content="☰" HorizontalAlignment="Left" Margin="3,2,0,12"
      AutomationProperties.Name="Toggle sidebar" ToolTip="Toggle sidebar (Ctrl+B)"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel x:Name="Navigation"/>
    </ScrollViewer>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
   <Border BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,0,1" Padding="22,0">
    <DockPanel>
     <Button x:Name="SearchButton" DockPanel.Dock="Right" Content="Search  ·  Ctrl+K" Margin="8,8,0,8"
      AutomationProperties.Name="Search commands"/>
     <TextBlock x:Name="Device" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" TextWrapping="NoWrap"
      TextTrimming="CharacterEllipsis"/>
    </DockPanel>
   </Border>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PageScroll">
    <StackPanel x:Name="PageBody" Margin="22,24,22,26" MaxWidth="1120">
     <TextBlock x:Name="Heading" FontSize="34" FontWeight="SemiBold" Margin="0,0,0,5"/>
     <TextBlock x:Name="Subtitle" Foreground="{DynamicResource Muted}" Margin="0,0,0,20"/>
     <StackPanel x:Name="Controls"/>
     <StackPanel x:Name="Results" Margin="0,8,0,0"/>
    </StackPanel>
   </ScrollViewer>
   <Border Grid.Row="2" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Padding="22,0">
    <DockPanel>
     <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel scans" Visibility="Collapsed" Margin="8,4,0,4" Padding="10,2"/>
     <TextBlock x:Name="Access" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
     <ProgressBar x:Name="Activity" DockPanel.Dock="Left" Width="38" Height="3" Margin="0,0,10,0"
       Foreground="{DynamicResource Accent}" Background="{DynamicResource Hover}" Visibility="Collapsed"/>
     <TextBlock x:Name="Status" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"
      TextWrapping="NoWrap" AutomationProperties.LiveSetting="Polite" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    </DockPanel>
   </Border>
  </Grid>
  <Grid x:Name="PaletteLayer" Grid.ColumnSpan="2" Background="#77000000" Visibility="Collapsed"/>
 </Grid>
</Window>
